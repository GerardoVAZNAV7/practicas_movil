<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Permisos de almacenamiento solicitados por la práctica.
        Desde Android 11 (API 30) WRITE_EXTERNAL_STORAGE ya no tiene efecto y desde
        Android 13 (API 33) READ_EXTERNAL_STORAGE tampoco aplica a archivos propios,
        por eso se limitan con maxSdkVersion. En Android 14 la app usa sus carpetas
        propias (internas y externas), que no necesitan permisos.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Practica11">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Practica11">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
